# Copy this file to .env and fill in real values before running against live Gemini.
# NEVER commit the real .env file.

# Google AI Studio API key (Gemini). Leave unset to run the backend in offline
# mock mode (see app/gemini_client.py) for local development without network
# access or a live key.
GEMINI_API_KEY=your-google-ai-studio-api-key-here

# Model tier names — kept as config, not hardcoded, since Gemini model version
# strings move quickly (per plan caveat). Re-check the AI Studio model picker
# at build/deploy time and update here if needed.
# Verified live 2026-09-23: gemini-2.5-flash/pro are retired for new users.
# gemini-3.6-flash confirmed working; gemini-pro-latest is a valid name (hit
# free-tier quota, not 404) — re-check if it starts 404'ing.
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-pro-latest

# If true (or if GEMINI_API_KEY is empty), all Gemini calls are served by the
# deterministic offline mock in app/gemini_client.py instead of calling the
# real API. Useful for local dev/testing without burning quota or needing
# network access. MUST be false (or key must be set) for any real demo.
GEMINI_MOCK_MODE=true

# CORS allowed origins (comma-separated). Deploy lane will add the deployed
# Vercel origin; localhost origins are included by default for dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend host/port for local dev.
HOST=0.0.0.0
PORT=8000
